#做一个👇
#👉 “中信银行 + 支付宝 + 微信 + 国内App 全直连规则包（Shadowrocket专用）”
RULE-SET,local-direct,DIRECT
# 微信 / 支付宝 / QQ / 抖音 / 国内App
DOMAIN-KEYWORD,wechat,DIRECT
DOMAIN-KEYWORD,wx,DIRECT
DOMAIN-KEYWORD,alipay,DIRECT
DOMAIN-KEYWORD,tenpay,DIRECT
DOMAIN-KEYWORD,tencent,DIRECT
DOMAIN-KEYWORD,qq,DIRECT
DOMAIN-KEYWORD,douyin,DIRECT
DOMAIN-KEYWORD,tiktok,DIRECT
DOMAIN-SUFFIX,a-map.cn
DOMAIN-SUFFIX,a-map.co
DOMAIN-SUFFIX,a-map.link
DOMAIN-SUFFIX,a-map.vip
DOMAIN-SUFFIX,amap.com
DOMAIN-SUFFIX,amapauto.com
DOMAIN-SUFFIX,anav.com
DOMAIN-SUFFIX,autonavi.com
DOMAIN-SUFFIX,gaode.com
# 银行类（中信 / 工行 / 建行等）
DOMAIN-SUFFIX,citicbank.com,DIRECT
DOMAIN-SUFFIX,citicbank.cn,DIRECT
DOMAIN-SUFFIX,icbc.com.cn,DIRECT
DOMAIN-SUFFIX,ccb.com,DIRECT
DOMAIN-SUFFIX,abcchina.com,DIRECT
DOMAIN-SUFFIX,boc.cn,DIRECT
DOMAIN-KEYWORD,citic,DIRECT
DOMAIN-KEYWORD,bank,DIRECT
# 国内CDN / DNS / 基础服务
GEOIP,CN,DIRECT

# 局域网
IP-CIDR,10.0.0.0/8,DIRECT
IP-CIDR,172.16.0.0/12,DIRECT
IP-CIDR,192.168.0.0/16,DIRECT
